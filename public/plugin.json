{
  "name": "CCConfig",
  "version": "1.0.1",
  "main": "index.html",
  "preload": "preload/services.js",
  "logo": "logo.png",
  "development": {
    "main": "http://localhost:5173"
  },
  "features": [
    {
      "code": "commonConfig",
      "explain": "通用配置（跨 agent 主数据）",
      "icon": "gen.svg",
      "cmds": ["通用配置"]
    },
    {
      "code": "installCommonSkill",
      "explain": "从 SkillHub/魔搭社区 安装通用 Skill（~/.agents/skills）",
      "icon": "gen.svg",
      "cmds": [
        {
          "type": "regex",
          "label": "安装通用 Skill",
          "match": "/^https:\\/\\/(www\\.)?(skillhub\\.(tencent\\.com|cn)\\/skills\\/[\\w-]+(\\/[\\w-]+)?|modelscope\\.cn\\/skills\\/@[\\w-]+\\/[\\w-]+)$/",
          "minLength": 30,
          "maxLength": 200
        }
      ]
    }
  ]
}
