{
  "name": "ccconfig",
  "version": "1.5.0",
  "description": "Multi-app AI configuration manager for Claude Code, OpenCode, Pi, Codex, Kimi Code, MiniMax Code, Qoder, ZCode, Hermes, DSH, Grok Build and Command Code. Ships as a uTools plugin and a standalone desktop app (macOS / Windows).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShaneLevs/CCConfig.git"
  },
  "keywords": [
    "claude-code",
    "opencode",
    "pi-agent",
    "omp",
    "reasonix",
    "codex",
    "kimi-code",
    "minimax-code",
    "qoder",
    "zcode",
    "hermes",
    "deepseek-harness",
    "grok-build",
    "command-code",
    "ai-cli",
    "llm-config",
    "api-key-switcher",
    "provider-manager",
    "anthropic",
    "openai",
    "mcp",
    "model-context-protocol",
    "skill-manager",
    "token-usage",
    "usage-analytics",
    "utools",
    "utools-plugin",
    "tauri",
    "tauri-app",
    "macos",
    "vue3",
    "tdesign"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "postinstall": "node scripts/install-preload-deps.mjs",
    "build": "npm run version:check && npm run i18n:check && npm run routes:check && vite build",
    "build:app": "npm run version:check && npm run i18n:check && npm run routes:check && cross-env CCCONFIG_TARGET=app vite build && node scripts/prepare-sidecar.mjs",
    "tauri:dev": "npm run build:app && tauri dev",
    "tauri:build": "npm run build:app && tauri build && node scripts/collect-release.mjs",
    "bump": "node scripts/bump-version.mjs",
    "version:check": "node scripts/check-versions.mjs",
    "i18n:check": "node scripts/check-i18n.mjs",
    "routes:check": "node tests/smoke-app-routes-test.cjs",
    "test": "node tests/run-all.cjs",
    "release:collect": "node scripts/collect-release.mjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.64.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "js-yaml": "^5.5.0",
    "ogl": "^1.0.11",
    "tdesign-vue-next": "^1.20.10",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@vitejs/plugin-vue": "^6.0.10",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "utools-api-types": "^8.0.0",
    "vite": "^8.3.5"
  }
}
