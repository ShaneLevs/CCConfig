{
  "name": "ccconfig",
  "version": "1.0.4",
  "description": "Multi-app AI configuration manager for Claude Code, OpenCode, Pi, Codex, Kimi Code, MiniMax Code, Qoder, ZCode, Hermes and DSH. Ships as a uTools plugin and a standalone macOS app.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShaneLevs/CCConfig.git"
  },
  "keywords": [
    "claude-code",
    "opencode",
    "pi-agent",
    "omp",
    "reasonix",
    "codex",
    "kimi-code",
    "minimax-code",
    "qoder",
    "zcode",
    "hermes",
    "deepseek-harness",
    "ai-cli",
    "llm-config",
    "api-key-switcher",
    "provider-manager",
    "anthropic",
    "openai",
    "mcp",
    "model-context-protocol",
    "skill-manager",
    "token-usage",
    "usage-analytics",
    "utools",
    "utools-plugin",
    "tauri",
    "tauri-app",
    "macos",
    "vue3",
    "tdesign"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run version:check && npm run i18n:check && vite build",
    "build:app": "npm run version:check && npm run i18n:check && CCCONFIG_TARGET=app vite build && node scripts/prepare-sidecar.mjs",
    "tauri:dev": "npm run build:app && cargo tauri dev",
    "tauri:build": "npm run build:app && cargo tauri build && node scripts/collect-release.mjs",
    "bump": "node scripts/bump-version.mjs",
    "version:check": "node scripts/check-versions.mjs",
    "i18n:check": "node scripts/check-i18n.mjs",
    "release:collect": "node scripts/collect-release.mjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.47.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "js-yaml": "^5.4.2",
    "ogl": "^1.0.11",
    "tdesign-vue-next": "^1.20.8",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.16"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "esbuild": "^0.28.2",
    "utools-api-types": "^7.5.1",
    "vite": "^8.3.0"
  }
}
